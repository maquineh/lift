interface Counter { value: int, label: string }
impl Counter {
    function add(amount: int): int {
        this.value = this.value + amount;
        return this.value;
    }
    function describe(): string { return `${this.label}:${this.value}`; }
    function snapshot(): Counter { return this; }
}
function increment(counter: Counter): int { return counter.add(1); }
const counter: Counter = { value: 1, label: "count" };
const before = (): string => counter.describe();
console.log(counter.add(2));
console.log(increment(counter));
console.log(before());
console.log(counter.describe());
const prefix = "hello";
const greet = (name: string): string => `${prefix}, ${name}!`;
console.log(greet("Lift"));
console.log(greet("Rust"));
console.log(`nested ${`value ${counter.value}`} \${literal} \`tick\``);
console.log(`order ${counter.value}/${counter.add(1)}/${counter.value}`);
const copy = counter.snapshot();
console.log(copy.describe());
console.log(counter.add(counter.value));
function borrowedCapture(text: string): string {
    const f = (): string => text;
    return f();
}
console.log(borrowedCapture("borrowed"));
const localMutation = (value: Counter): int => {
    let n = 1;
    n = n + 1;
    value.value = value.value + n;
    return value.value;
};
console.log(localMutation(counter));
console.log(counter.value);
console.log(((n: int): int => n + 1)(10));
const nested = (): string => {
    const inner = (): string => prefix;
    return inner();
};
console.log(nested());
console.log(counter.add(counter.add(1)));
const ownedMethod = (value: Counter): int => value.add(1);
console.log(ownedMethod(counter));
console.log(counter.value);
const x = (): int => 1;
const outer = (): int => {
    const inner = (x: int): int => x;
    return inner(2);
};
console.log(outer());
const outerLocal = (): string => {
    const prefix = "inside";
    const inner = (): string => prefix;
    return inner();
};
console.log(outerLocal());
