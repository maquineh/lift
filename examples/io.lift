// EN: Run with two arguments (output path and label); stdin is read until EOF.
// PT-BR: Execute com dois argumentos (caminho de saída e rótulo); stdin é lido até EOF.
import function arguments(): Result<string[], string> from "lift_core::io::arguments";
import function read_stdin(): Result<string, string> from "lift_core::io::read_stdin";
import function read_file(path: string): Result<string, string> from "lift_core::io::read_file";
import function write_file(path: string, contents: string): Result<void, string> from "lift_core::io::write_file";
import function argument_count(values: string[]): int from "lift_core::interop::array_len";
import function trim(value: string): string from "lift_core::interop::string_trim";

const args_result = arguments();
if result.is_ok(args_result) {
    const args: string[] = result.unwrap(args_result);
    if argument_count(args) == 2 {
        const input = read_stdin();
        if result.is_ok(input) {
            const contents: string = trim(result.unwrap(input));
            const written = write_file(args[0], contents + "|" + args[1]);
            if result.is_ok(written) {
                result.unwrap(written);
                const output = read_file(args[0]);
                if result.is_ok(output) {
                    console.log(argument_count(args));
                    console.log(result.unwrap(output));
                } else {
                    console.log(result.unwrap_err(output));
                }
            } else {
                console.log(result.unwrap_err(written));
            }
        } else {
            console.log(result.unwrap_err(input));
        }
    } else {
        console.log("Expected: output-path label; input is read until EOF.");
    }
} else {
    console.log(result.unwrap_err(args_result));
}
