// EN: Root statements run once, even when an imported module refers back here.
// PT-BR: Statements root executam uma vez, mesmo com ciclo voltando a este arquivo.
import module "models.lift";
import module "math/api.lift";
import module "./models.lift";

function root_label(): string { return "root"; }

const product: Product = make_product("  Lift  ", 20);
console.log(product.name);
console.log(total(product, 3));
console.log(module_label());
console.log("root executed once");
