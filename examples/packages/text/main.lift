import function text_length(value: string): int from "lift_core::interop::string_len";
interface Item { value: string }
impl Item { function get(): string { return this.value; } }
function same(): int { return 2; }

export function decorate(name: string): string {
    const item: Item = { value: name };
    const suffix = (tail: string): string => item.get() + tail;
    return suffix("!");
}
export function length(name: string): int { return text_length(name); }
